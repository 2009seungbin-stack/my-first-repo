{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "platform/**/*.js",
    "server/platform/**/*.js",
    "server/oauth/**/*.js",
    "src/admin/**/*.js",
    "src/signin-brands.js"
  ],
  "exclude": [
    "src/admin/sw.js"
  ]
}
