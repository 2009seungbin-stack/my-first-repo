/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net blob: 'wasm-unsafe-eval'; worker-src 'self' blob: https://cdn.jsdelivr.net; connect-src 'self' https://cdn.jsdelivr.net https://huggingface.co https://*.huggingface.co https://*.hf.co; img-src 'self' blob: data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' blob: data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'
/ai-runtime/
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  Document-Isolation-Policy: isolate-and-credentialless
  X-Robots-Tag: noindex, nofollow
# Mutable app URLs must not retain code from a prior release. The custom domain
# overrides no-cache with a four-hour TTL; no-store also forbids browser storage.
/src/*
  ! Cache-Control
  Cache-Control: no-store
/ai-runtime/*
  ! Cache-Control
  Cache-Control: no-store
/styles.css
  ! Cache-Control
  Cache-Control: no-store
/experience.css
  ! Cache-Control
  Cache-Control: no-store
/content.css
  ! Cache-Control
  Cache-Control: no-store
# Third-party libraries live in folders named after their exact version
# (assets/vendor/pdfjs-dist-6.3.289/…): an upgrade changes the URL, so a stored copy can never be
# stale. A year of reuse spares returning visitors megabytes of WASM, fonts and character maps.
# :library matches one folder, so NOTICES.txt and the other unversioned files beside the folders keep revalidating.
/assets/vendor/:library/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
