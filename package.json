{
  "name": "fileforge-studio",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/check.mjs",
    "test:browser": "python tools/regression.py",
    "indexnow": "node tools/indexnow.mjs",
    "vendor": "node tools/vendor.mjs",
    "benchmark": "python tools/benchmark.py",
    "benchmark:full": "python tools/benchmark.py --full",
    "benchmark:pdf": "python tools/benchmark.py --pdf",
    "benchmark:media": "python tools/generate-media.py && python tools/benchmark.py --media",
    "benchmark:ai": "python tools/benchmark.py --ai",
    "benchmark:lifecycle": "python tools/generate-media.py && python tools/lifecycle.py",
    "benchmark:media:quality": "python tools/media-quality.py"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@mediabunny/mp3-encoder": "1.58.1",
    "@pdf-lib/fontkit": "1.1.1",
    "gifenc": "1.0.3",
    "mediabunny": "1.58.1",
    "onnxruntime-web": "1.30.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "pica": "10.0.3"
  }
}
